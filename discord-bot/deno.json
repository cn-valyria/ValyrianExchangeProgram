{
  "tasks": {
    "check": "deno fmt --check && deno lint && deno test",
    "register": "deno run --allow-env --allow-net=discord.com scripts/register-commands.js",
    "serve": "deno run --allow-net --allow-env scripts/serve-local.js"
  },
  "fmt": {
    "lineWidth": 120
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-import-prefix"
      ]
    }
  }
}
