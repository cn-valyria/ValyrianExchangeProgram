# Database Connection String
# Format: server=<host>;database=<db_name>;user=<username>;password=<password>
ConnectionStrings__VepDb=server=localhost;database=vep_db;user=your_user;password=your_password

# JWT Secret Key (use a strong random key in production)
# Generate with: openssl rand -hex 32
JwtSecret=your_jwt_secret_key_here_minimum_32_characters
